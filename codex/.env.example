# Use Node 24 or newer. Copy this file to .env and fill in your own values.
PORT=3000
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3000
# At least 12 characters. Admin is disabled until this is configured.
ADMIN_PASSWORD=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
DATABASE_PATH=./data/playprover.sqlite
# Set true behind an HTTPS reverse proxy in production.
COOKIE_SECURE=false
