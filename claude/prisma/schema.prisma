// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(cuid())
  name         String        @unique
  createdAt    DateTime      @default(now())
  resources    Resource[]
  gameSessions GameSession[]
}

model Resource {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pairs     Pair[]

  @@index([userId])
}

model Pair {
  id         String        @id @default(cuid())
  resourceId String
  resource   Resource      @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  sentenceA  String
  sentenceB  String
  createdAt  DateTime      @default(now())
  attempts   PairAttempt[]

  @@index([resourceId])
}

model GameSession {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  correctCount   Int           @default(0)
  incorrectCount Int           @default(0)
  startedAt      DateTime      @default(now())
  endedAt        DateTime?
  roundsPlayed   Int           @default(0)
  quit           Boolean       @default(false)
  attempts       PairAttempt[]

  @@index([userId])
}

// Records a Pair that was answered incorrectly in a session, so a future
// phase can suggest resources to restudy from misses. Only misses are
// recorded — correct answers just increment GameSession.correctCount.
model PairAttempt {
  id            String      @id @default(cuid())
  gameSessionId String
  gameSession   GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  pairId        String
  pair          Pair        @relation(fields: [pairId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@index([gameSessionId])
  @@index([pairId])
}

// Fixed-window counter backing the per-IP AI extraction rate limit
// (lib/ai/rate-limit.ts). One row per distinct IP ever seen.
model AiRateLimit {
  ip          String   @id
  windowStart DateTime
  count       Int      @default(0)
}
