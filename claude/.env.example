# Postgres connection string (Neon recommended: https://neon.tech).
# Use Neon's pooled connection string here for serverless/Vercel deployments.
DATABASE_URL="postgresql://user:password@host:5432/studyscheme?sslmode=require"

# Secret used to encrypt the session cookie. Must be at least 32 characters.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=""

# Anthropic API key, used in a later phase for AI knowledge extraction.
ANTHROPIC_API_KEY=""
